{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-free-tier-admin",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "hono-free-tier-admin",
      "database_id": "170908ef-2c2d-444b-bb32-fa059f319ebf",
      "migrations_dir": "src/db/migrations"
    }
  ]
}
